# Copie para .env (local) ou configure no seu host (Vercel/Netlify/etc).
# Pegue em: Supabase novo → Settings → API Keys (Publishable / sb_publishable_...)
# e Settings → API (URL e Project ref).

# Cliente (Vite expõe ao browser — só publishable/anon)
VITE_SUPABASE_URL=https://<SEU_REF>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<SUA_PUBLISHABLE_KEY>
VITE_SUPABASE_PROJECT_ID=<SEU_REF>

# Servidor (TanStack Start SSR / server functions)
SUPABASE_URL=https://<SEU_REF>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<SUA_PUBLISHABLE_KEY>
SUPABASE_PROJECT_ID=<SEU_REF>

# Server-only (NUNCA expor ao cliente; só para server functions com supabaseAdmin)
SUPABASE_SERVICE_ROLE_KEY=<SUA_SECRET_KEY_sb_secret_...>
